# --- Network (localnet | testnet | mainnet) — cookie key: selectedNetwork
# Default when no cookie (and SSR). Cookie is set on first visit via NetworkProvider.
NEXT_PUBLIC_DEFAULT_NETWORK=testnet
# Per-tier GraphQL HTTP URL overrides (optional; see lib/network-utils.ts for defaults)
# NEXT_PUBLIC_MYSO_GRAPHQL_MAINNET_URL=https://graphql.mainnet.mysocial.network/graphql
# NEXT_PUBLIC_MYSO_GRAPHQL_TESTNET_URL=https://graphql.testnet.mysocial.network/graphql
# NEXT_PUBLIC_MYSO_GRAPHQL_LOCALNET_URL=http://127.0.0.1:9125/graphql
# Per-tier fullnode JSON-RPC (optional; /api/fullnode proxy uses cookie network + these)
# NEXT_PUBLIC_MYSO_JSON_RPC_MAINNET_URL=
# NEXT_PUBLIC_MYSO_JSON_RPC_TESTNET_URL=
# NEXT_PUBLIC_MYSO_JSON_RPC_LOCALNET_URL=
# Legacy: forces all networks to one fullnode if set (overrides tier resolution)
# NEXT_PUBLIC_MYSO_FULLNODE=

# Server-only: gas pool HTTP API (no trailing slash). Proxied at /api/gas-pool/reserve and /api/gas-pool/execute; not used on localnet.
# GAS_POOL_BASE_URL=https://your-gas-pool.example.com

# MySocial Auth (@socialproof/mysocial-auth) — register redirect URI with the auth console
NEXT_PUBLIC_MYSOCIAL_AUTH_CLIENT_ID=
# Canonical site origin (marketing). During local dev the SDK uses the **browser origin** if this host differs, so OAuth state stays on localhost.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Optional. Must be exactly: {origin}/auth/callback (not the site root `/`). If omitted, the app uses window.location.origin + /auth/callback.
# NEXT_PUBLIC_MYSOCIAL_AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_MYSOCIAL_AUTH_ORIGIN=https://auth.testnet.mysocial.network
# Auth + salt API base (must match SDK apiBaseUrl and Bearer /salt calls)
NEXT_PUBLIC_MYSOCIAL_AUTH_API_BASE_URL=https://salt.testnet.mysocial.network
# Optional: server-side override for where /api/mysocial forwards (defaults to NEXT_PUBLIC_MYSOCIAL_AUTH_API_BASE_URL)
# MYSOCIAL_AUTH_API_BASE_URL=https://salt.testnet.mysocial.network
# Optional alias used by getMySocialAuth if CLIENT_ID is unset (dev only)
# NEXT_PUBLIC_DEV_CLIENT_ID=
# Optional: set to false to force full-page redirect on desktop too (strict COOP / SES). Mobile/tablet always redirect.
# NEXT_PUBLIC_MYSOCIAL_AUTH_USE_POPUP=false

# --- SofiSwap platform gate (GraphQL platformUserAccess + join_platform PTB)
# GraphQL `platformId` for platformUserAccess (often the on-chain Platform object ID).
NEXT_PUBLIC_SOFISWAP_PLATFORM_ID=0xc10390082ee200bc4da601a071ebe50bb3c2645c3578135bde3dc26222d66469
# Published Move package ID containing module `platform` with `join_platform` (0x...::platform::join_platform).
NEXT_PUBLIC_MYSO_PLATFORM_PACKAGE_ID=0x50c1
# Shared object IDs passed to join_platform: registry, block list registry, Platform object (&mut Platform).
NEXT_PUBLIC_MYSO_PLATFORM_REGISTRY_OBJECT_ID=0x308505c62d9b637fc1f0ec8d0cca0efd917255998d377c96c3949bf905b49773
NEXT_PUBLIC_MYSO_BLOCK_LIST_REGISTRY_OBJECT_ID=0xd554ef63ac7b80a1ad17771e30c01e18acdb8103b90025221362168e79018f08

# --- Orderbook / balance manager (mainnet & testnet only; localnet skips registry checks in the trade gate)
# When unset or any value other than "false", `join_platform` is bundled with create+share+register BalanceManager (see lib/tx/join-platform.ts).
# Set to false if `join_platform` already performs full orderbook setup on-chain.
# NEXT_PUBLIC_TRADING_SETUP_WITH_JOIN=false
#
# If fullnode returns "Package object does not exist" for the default SDK package ID, set the IDs deployed on YOUR network:
# NEXT_PUBLIC_ORDERBOOK_PACKAGE_ID_TESTNET=0x...
# NEXT_PUBLIC_ORDERBOOK_REGISTRY_ID_TESTNET=0x...
# NEXT_PUBLIC_ORDERBOOK_PACKAGE_ID_MAINNET=0x...
# NEXT_PUBLIC_ORDERBOOK_REGISTRY_ID_MAINNET=0x...

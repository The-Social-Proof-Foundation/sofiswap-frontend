# --- Network (localnet | testnet | mainnet) — cookie key: selectedNetwork
# Default when no cookie (and SSR). Cookie is set on first visit via NetworkProvider.
NEXT_PUBLIC_DEFAULT_NETWORK=localnet
# Per-tier GraphQL HTTP URL overrides (optional; see lib/network-utils.ts for defaults)
# NEXT_PUBLIC_MYSO_GRAPHQL_MAINNET_URL=https://graphql.mainnet.mysocial.network/graphql
# NEXT_PUBLIC_MYSO_GRAPHQL_TESTNET_URL=https://graphql.testnet.mysocial.network/graphql
# NEXT_PUBLIC_MYSO_GRAPHQL_LOCALNET_URL=http://127.0.0.1:9125/graphql
# Per-tier fullnode JSON-RPC (optional; /api/fullnode pins each request to its explicit network)
# NEXT_PUBLIC_MYSO_JSON_RPC_MAINNET_URL=
# NEXT_PUBLIC_MYSO_JSON_RPC_TESTNET_URL=
# NEXT_PUBLIC_MYSO_JSON_RPC_LOCALNET_URL=
# Social indexer REST base (profiles, GET /spt/reservation-pools for trade footer marquee). Testnet defaults to Railway if unset.
# NEXT_PUBLIC_SOCIAL_INDEXER_URL=
# NEXT_PUBLIC_SOCIAL_INDEXER_TESTNET_URL=
# NEXT_PUBLIC_SOCIAL_INDEXER_MAINNET_URL=
# NEXT_PUBLIC_SOCIAL_INDEXER_LOCALNET_URL=
# Gas pool (browser calls /api/gas-pool/*; testnet/mainnet only — localnet skips sponsored gas). Fallback URL/token when tier-specific vars omitted.
# NEXT_PUBLIC_GAS_POOL_URL=
# GAS_POOL_TOKEN=
# NEXT_PUBLIC_GAS_POOL_URL_TESTNET=
# NEXT_PUBLIC_GAS_POOL_URL_MAINNET=
# GAS_POOL_TOKEN_TESTNET=
# GAS_POOL_TOKEN_MAINNET=

# MySocial Auth (@socialproof/mysocial-auth) — register redirect URI with the auth console (same client ID for testnet + mainnet).
NEXT_PUBLIC_MYSOCIAL_AUTH_CLIENT_ID=
# When set, pins authorize + Salt hosts for all tiers (disables cookie-based auth routing). When unset, tier follows `selectedNetwork` (localnet defaults to testnet auth/salt).
# NEXT_PUBLIC_MYSOCIAL_AUTH_ORIGIN=https://auth.testnet.mysocial.network
# NEXT_PUBLIC_MYSOCIAL_AUTH_API_BASE_URL=https://salt.testnet.mysocial.network
# Optional: server-only Salt override (same pinning behavior as NEXT_PUBLIC_MYSOCIAL_AUTH_API_BASE_URL)
# MYSOCIAL_AUTH_API_BASE_URL=https://salt.testnet.mysocial.network
# Optional tier-specific authorize host when globals are unset:
# NEXT_PUBLIC_MYSOCIAL_AUTH_ORIGIN_MAINNET=
# NEXT_PUBLIC_MYSOCIAL_AUTH_ORIGIN_TESTNET=
# NEXT_PUBLIC_MYSOCIAL_AUTH_ORIGIN_LOCALNET=
# Optional tier-specific Salt origin for /api/mysocial:
# NEXT_PUBLIC_MYSOCIAL_AUTH_API_MAINNET_URL=
# NEXT_PUBLIC_MYSOCIAL_AUTH_API_TESTNET_URL=
# NEXT_PUBLIC_MYSOCIAL_AUTH_API_LOCALNET_URL=
# Optional alias used if CLIENT_ID is unset (dev only)
# NEXT_PUBLIC_DEV_CLIENT_ID=
# Optional: set to false to force full-page redirect on desktop too (strict COOP / SES). Mobile/tablet always redirect.
# NEXT_PUBLIC_MYSOCIAL_AUTH_USE_POPUP=false

# Canonical site origin (marketing). During local dev the SDK uses the **browser origin** if this host differs, so OAuth state stays on localhost.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Optional. Must be exactly: {origin}/auth/callback (not the site root `/`). If omitted, the app uses window.location.origin + /auth/callback.
# NEXT_PUBLIC_MYSOCIAL_AUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# --- GraphQL discovery (no deployed object IDs need to be pasted here)
# Shared SPT objects, approved SofiSwap platform, profile/post pools and native markets
# are discovered from the selected network and refreshed in the UI.
# Social framework package defaults to the canonical 0x50c1; override only for a custom deployment.
# NEXT_PUBLIC_MYSOCIAL_PACKAGE_ID_LOCALNET=0x50c1
# NEXT_PUBLIC_MYSOCIAL_PACKAGE_ID_TESTNET=0x50c1
# NEXT_PUBLIC_MYSOCIAL_PACKAGE_ID_MAINNET=0x50c1

# Orderbook indexer HTTP base (same server also serves GET {base}get_pools as JSON).
# Mainnet/testnet fall back to https://orderbook.{tier}.mysocial.network/ when tier-specific vars are unset.
# Localnet has no implicit URL — use LOCALNET_URL or NEXT_PUBLIC_ORDERBOOK_INDEXER_URL.
# Paths (trailing slash optional): trades/{pool}, ohclv/{pool}, orderbook/{pool}, get_pools
# NEXT_PUBLIC_ORDERBOOK_INDEXER_MAINNET_URL=
# NEXT_PUBLIC_ORDERBOOK_INDEXER_TESTNET_URL=
# NEXT_PUBLIC_ORDERBOOK_INDEXER_LOCALNET_URL=
# When a tier-specific var is unset, this applies to every tier without its own URL (legacy single-origin setups):
# NEXT_PUBLIC_ORDERBOOK_INDEXER_URL=http://127.0.0.1:9008/
# Recent trades: GET {base}trades/{pool} — JSON array of fill rows (see orderbook server); optional limit (default 1 server-side if omitted; this app sends 50).
# Depth source for the trade rail: `sdk` (default: MySo gRPC + @socialproof/orderbook, including localnet reads) or `indexer` (HTTP above).
# NEXT_PUBLIC_ORDERBOOK_DEPTH_SOURCE=indexer
# gRPC-web base URLs for MySo fullnode (see @socialproof/myso README). Use HTTPS + CORS-enabled endpoints for production browser reads.
# NEXT_PUBLIC_MYSO_GRPC_MAINNET_URL=https://fullnode.mainnet.mysocial.network:443
# NEXT_PUBLIC_MYSO_GRPC_TESTNET_URL=https://fullnode.testnet.mysocial.network:443
# NEXT_PUBLIC_MYSO_GRPC_LOCALNET_URL=http://127.0.0.1:9000
# --- Orderbook / balance manager (mainnet, testnet, and localnet reads + transactions)
# When unset or any value other than "false", `join_platform` is bundled with create+share+register BalanceManager (see lib/tx/join-platform.ts).
# Set to false if `join_platform` already performs full orderbook setup on-chain.
# NEXT_PUBLIC_TRADING_SETUP_WITH_JOIN=false
#
# Orderbook Move package (registry object id is hardcoded 0x10 in lib/orderbook/config.ts — not env-configurable):
# NEXT_PUBLIC_ORDERBOOK_PACKAGE_ID=0x...
# Optional per-tier package overrides:
# NEXT_PUBLIC_ORDERBOOK_PACKAGE_ID_TESTNET=0x...
# NEXT_PUBLIC_ORDERBOOK_PACKAGE_ID_MAINNET=0x...
# Localnet defaults to canonical orderbook package 0xb0c; GraphQL discovers coin types, decimals and pools.
# NEXT_PUBLIC_ORDERBOOK_PACKAGE_ID_LOCALNET=0xb0c
# Legacy offline fallback only: full deployment JSON. Not required for GraphQL discovery.
# NEXT_PUBLIC_ORDERBOOK_LOCALNET_MANIFEST_JSON={"network":{...},"packages":{...},"pools":{...}}
# Optional: merge pool object ids over the testnet-based map — object or array (see lib/orderbook/localnet-pool-map.ts).
# NEXT_PUBLIC_ORDERBOOK_LOCALNET_POOLS_JSON=[{"poolId":"0x…","baseCoinType":"0x…::myso::MYSO","quoteCoinType":"0x…::myusd::MYUSD"}]
